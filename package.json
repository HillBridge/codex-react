{
  "name": "merchant-admin-foundation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @merchant/web dev",
    "dev:backend": "pnpm --filter @merchant/server dev",
    "start": "pnpm --filter @merchant/server start",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r typecheck",
    "check:deprecated": "pnpm -r check:deprecated",
    "lint": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"apps/web/src/**/*.css\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,json}\" \"tests/**/*.ts\" \"apps/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{ts,js,mjs,json,html}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,json}\" \"tests/**/*.ts\" \"apps/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{ts,js,mjs,json,html}\"",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint:styles && pnpm typecheck && pnpm check:deprecated && pnpm lint && pnpm test && pnpm build",
    "start:prod": "pnpm --filter @merchant/server start:prod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
